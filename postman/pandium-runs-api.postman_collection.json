                        "disableBodyPruning": true
                      },
                      "request": {
                        "method": "POST",
                        "header": [
                          {
                            "key": "Accept",
                            "value": "application/json"
                          }
                        ],
                        "url": {
                          "raw": "{{baseUrl}}/v2/tenants/:tenant_id/sync?mode=normal",
                          "host": [
                            "{{baseUrl}}"
                          ],
